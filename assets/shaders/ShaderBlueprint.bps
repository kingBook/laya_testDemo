true,\"uniformMap\":{\"AlbedoTexture\":{\"type\":\"Texture2D\",\"default\":\"white\",\"alias\":\"AlbedoTexture\",\"index\":0}},\"attributeMap\":null,\"shaderPass\":[{\"pipeline\":\"Forward\",\"VS\":\"VS0\",\"FS\":\"FS0\"},{\"pipeline\":\"META\",\"VS\":\"VS1\",\"FS\":\"FS1\",\"isIDE\":true},{\"pipeline\":\"ShadowCaster\",\"VS\":\"VS2\",\"FS\":\"FS2\"},{\"pipeline\":\"_editPos\",\"VS\":\"VS3\",\"FS\":\"FS3\",\"isIDE\":true}]}\r\nShader3D End\r\nGLSL Start\r\n#defineGLSL VS0\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Camera.glsl\";\n        #include \"Sprite3DVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelVertex.glsl\";\n        void main()\n        {\n            Vertex vertex;\n            getVertexParams(vertex);\n            \n        vec3 positionOS = vertex.positionOS;\nfloat sin_213 = sin(u_Time);\nfloat add_223 = sin_213+1.0;\nfloat div_234 = add_223/2.0;\nfloat mul_340 = div_234*2.0;\nvec3 mul_263 = vec3(mul_340)*positionOS;\nvec3 vec_357 = vec3(positionOS.x,mul_263.y,positionOS.z);\n vertex.positionOS = vec_357;\n\tPixelParams pixel;\n            initPixelParams(pixel, vertex);\n        \n            varyingPixelParams(pixel);\n            gl_Position = getPositionCS(pixel.positionWS);\n            gl_Position = remapPositionZ(gl_Position);\n        \n        }\n            \r\n#endGLSL\r\n#defineGLSL FS0\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Camera.glsl\";\n        #include \"Sprite3DFrag.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelFrag.glsl\";\n        #include \"shaderBlueprint/lightmode/BlueprintBlinn.glsl\";\nvoid main()\n        {\n            PixelParams pixel;\n            getPixelParams(pixel);\n        vec2 uv0 = vec2(0.0, 0.0);\n#ifdef UV\nuv0 = pixel.uv0;\n#endif // UV\n\tvec4 finalColor = vec4(0.0, 0.0, 0.0, 1.0);\n        Surface surface;\n surface.normalTS = vec3(0.0,0.0,1.0);\nvec4 sam_158 = texture2D(AlbedoTexture,uv0);\n\n            #ifdef Gamma_AlbedoTexture\n            sam_158 = gammaToLinear(sam_158);\n            #endif\n            \n surface.diffuseColor = sam_158.xyz;\n surface.specularColor = vec3(0.5,0.5,0.5);\n surface.shininess = 0.0781;\n surface.gloss = vec3(0.0);\n surface.alpha = 1.0;\n\n        \n                PixelInfo info;\n                getPixelInfo(info, pixel, surface);\n                vec4 surfaceColor = SurfaceShading(surface, info);\nfinalColor = surfaceColor;\n\n        \tgl_FragColor = finalColor;\n        }\r\n#endGLSL\r\n#defineGLSL VS1\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Camera.glsl\";\n        #include \"Sprite3DVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelVertex.glsl\";\n        void main()\n        {\n            Vertex vertex;\n            getVertexParams(vertex);\n            \n        vec3 positionOS = vertex.positionOS;\nfloat sin_213 = sin(u_Time);\nfloat add_223 = sin_213+1.0;\nfloat div_234 = add_223/2.0;\nfloat mul_340 = div_234*2.0;\nvec3 mul_263 = vec3(mul_340)*positionOS;\nvec3 vec_357 = vec3(positionOS.x,mul_263.y,positionOS.z);\n vertex.positionOS = vec_357;\n\tPixelParams pixel;\n            initPixelParams(pixel, vertex);\n        \n            varyingPixelParams(pixel);\n            gl_Position = getPositionCS(pixel.positionWS);\n            gl_Position = remapPositionZ(gl_Position);\n        \ngl_Position = vec4(a_Texcoord1 * 2.0 - 1.0, 0.0, 1.0);\n                    \n\n        }\n            \r\n#endGLSL\r\n#defineGLSL FS1\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Camera.glsl\";\n        #include \"Sprite3DFrag.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelFrag.glsl\";\n        #include \"shaderBlueprint/lightmode/BlueprintBlinn.glsl\";\nvoid main()\n        {\n            PixelParams pixel;\n            getPixelParams(pixel);\n        vec2 uv0 = vec2(0.0, 0.0);\n#ifdef UV\nuv0 = pixel.uv0;\n#endif // UV\n\tvec4 finalColor = vec4(0.0, 0.0, 0.0, 1.0);\n        Surface surface;\n surface.normalTS = vec3(0.0,0.0,1.0);\nvec4 sam_158 = texture2D(AlbedoTexture,uv0);\n\n            #ifdef Gamma_AlbedoTexture\n            sam_158 = gammaToLinear(sam_158);\n            #endif\n            \n surface.diffuseColor = sam_158.xyz;\n surface.specularColor = vec3(0.5,0.5,0.5);\n surface.shininess = 0.0781;\n surface.gloss = vec3(0.0);\n surface.alpha = 1.0;\n\n        \nPixelInfo info;\ngetPixelInfo(info, pixel, surface);\n\nvec4 surfaceColor = vec4(1.0, 0.0, 1.0, 1.0);\n\n#ifdef METAALBEDO\nsurfaceColor = vec4(surface.diffuseColor, surface.alpha);\n#endif // METAALBEDO\n\n#ifdef METANORMAIL\nsurfaceColor = vec4(normalize(surface.normalTS * vec3(1.0, -1.0, 1.0) * 0.5 + 0.5), 1.0);\n#endif // METANORMAIL\n\n#ifdef METAEMISSION\nsurfaceColor = vec4(vec3(0.0), 1.0);\n#endif // METAEMISSION\n\n#ifdef METAEMETALLIC\nsurfaceColor = vec4(vec3(0.0), 1.0);\n#endif // METAEMETALLIC\n\n#ifdef METAEROUNGNESS\nsurfaceColor = vec4(vec3(1.0), 1.0);\n#endif // METAEROUNGNESS\n                \nfinalColor = surfaceColor;\n\n        \tgl_FragColor = finalColor;\n        }\r\n#endGLSL\r\n#defineGLSL VS2\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Sprite3DVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintDepthVertex.glsl\";\n        void main()\n        {\n            Vertex vertex;\n            getVertexParams(vertex);\n        vec3 positionOS = vertex.positionOS;\nfloat sin_213 = sin(u_Time);\nfloat add_223 = sin_213+1.0;\nfloat div_234 = add_223/2.0;\nfloat mul_340 = div_234*2.0;\nvec3 mul_263 = vec3(mul_340)*positionOS;\nvec3 vec_357 = vec3(positionOS.x,mul_263.y,positionOS.z);\n vertex.positionOS = vec_357;\n\tPixelParams pixel;\n            initPixelParams(pixel, vertex);\n        \tgl_Position = DepthPositionCS(pixel.positionWS, pixel.normalWS);\n            gl_Position = remapPositionZ(gl_Position);\n                }\r\n#endGLSL\r\n#defineGLSL FS2\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Sprite3DFrag.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelFrag.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintDepthFrag.glsl\";\n        void main()\n        {\n            gl_FragColor = getDepthColor();\n        }\r\n#endGLSL\r\n#defineGLSL VS3\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Camera.glsl\";\n        #include \"Sprite3DVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelVertex.glsl\";\n        void main()\n        {\n            Vertex vertex;\n            getVertexParams(vertex);\n            \n        vec3 positionOS = vertex.positionOS;\nfloat sin_213 = sin(u_Time);\nfloat add_223 = sin_213+1.0;\nfloat div_234 = add_223/2.0;\nfloat mul_340 = div_234*2.0;\nvec3 mul_263 = vec3(mul_340)*positionOS;\nvec3 vec_357 = vec3(positionOS.x,mul_263.y,positionOS.z);\n vertex.positionOS = vec_357;\n\tPixelParams pixel;\n            initPixelParams(pixel, vertex);\n        \n            varyingPixelParams(pixel);\n            gl_Position = getPositionCS(pixel.positionWS);\n            gl_Position = remapPositionZ(gl_Position);\n        \n        }\n            \r\n#endGLSL\r\n#defineGLSL FS3\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Camera.glsl\";\n        #include \"Sprite3DFrag.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelFrag.glsl\";\n        \n        void main()\n        {\n            PixelParams pixel;\n            getPixelParams(pixel);\n        \tvec4 finalColor = vec4(pixel.positionWS, 1.0);\n        \tgl_FragColor = finalColor;\n        }\r\n#endGLSL\r\nGLSL End\r\n","version":1755245454132,"tabList":[],"materialType":1,"currAutoCreateDefault":1,"funVersion":{"shaders/ShaderFunction.bpsf":1754293698902}}